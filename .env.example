# --- Stage 1 transcription providers (pick per run with --provider; gemini is default) ---

# Google AI (Gemini) — audio->text via the Files API. Default provider.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Groq Whisper — cheaper, faster, purpose-built STT. Use with: --provider groq
# Free key at https://console.groq.com/keys
GROQ_API_KEY=your-key-here

# NOTE: Zen (opencode) is a TEXT-only coding gateway. It CANNOT transcribe audio — only
# Gemini models take audio and Zen's Gemini integration is non-functional (400 on every
# call), while every working Zen model (Claude/GPT/DeepSeek/…) is text-only. So Zen is
# unusable for Stage 1. Left here only as a reminder. See MEMORY.md (2026-07-02).
# ZEN_API_KEY=your-key-here

# --- Optional overrides ---
# COURSE_TO_MD_PROVIDER=gemini
# COURSE_TO_MD_MODEL=gemini-2.5-flash
# COURSE_TO_MD_GROQ_MODEL=whisper-large-v3-turbo
# COURSE_TO_MD_THINKING_BUDGET=0
# COURSE_TO_MD_TRANSCRIBE_MAX_TOKENS=65536
# COURSE_TO_MD_FORMAT_MAX_TOKENS=16384
# Point at the knowledge-compiler skill if this project is used outside the repo:
# KNOWLEDGE_COMPILER_DIR=/abs/path/to/knowledge/skills/knowledge-compiler
